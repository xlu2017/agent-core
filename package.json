{
  "name": "agent-core",
  "version": "0.1.0",
  "description": "Standalone memory and action service for an agent-aware development platform",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "smoke": "bash scripts/smoke_test.sh",
    "eval:llm": "tsx scripts/eval_llm.ts",
    "memory:eval": "tsx scripts/memory-eval.ts",
    "bench": "tsx scripts/benchmark-runner.ts",
    "test:retrieval": "vitest run tests/retrieval/",
    "retrieval-benchmark": "tsx scripts/retrieval-benchmark.ts",
    "test:parity": "vitest run tests/parity/",
    "test:perf": "vitest run tests/performance/",
    "test:all": "vitest run",
    "parity-report": "tsx scripts/parity-report.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/swagger": "9.7.0",
    "@fastify/swagger-ui": "5.2.6",
    "better-sqlite3": "11.10.0",
    "fastify": "5.8.5",
    "uuid": "11.1.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.19.20",
    "@types/uuid": "10.0.0",
    "eslint": "9.39.4",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.1",
    "vitest": "3.2.6"
  }
}
